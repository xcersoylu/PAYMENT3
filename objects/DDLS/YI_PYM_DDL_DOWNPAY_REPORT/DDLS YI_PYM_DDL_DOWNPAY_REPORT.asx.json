    "SOURCE":"@EndUserText.label: 'Peşinat Ödeme Listesi Raporu'\r\n@ObjectModel.query.implementedBy:'ABAP:YCL_PYM_DOWNPAY_REPORT'\r\n@UI:{\r\nheaderInfo:{\r\n                typeNamePlural: 'Peşinat Ödeme Listesi Raporu',\r\n                typeName: 'Peşinat Ödeme Listesi Raporu',\r\n                title:{ type: #STANDARD, label: 'Peşinat Ödeme Listesi Raporu', value: 'paymentnumber' }\r\n\r\n           }\r\n}\r\ndefine custom entity YI_PYM_DDL_DOWNPAY_REPORT\r\n{\r\n      @UI                         : { lineItem:       [ { position: 10  } ] , selectionField: [ { position: 10 } ] }\r\n  key paymentnumber               : ypym_e_paymentnumber;\r\n        @UI                         : { lineItem:       [ { position: 20  } ] , selectionField: [ { position: 20 } ] }\r\n  key purchaseorder               : ebeln;\r\n      @UI                         : { lineItem:       [ { position: 30  } ] }\r\n  key purchaseorderitem           : ebelp;\r\n      @UI                         : { lineItem:       [ { position: 40  } ] , selectionField: [ { position: 30 } ] }\r\n      @Consumption.valueHelpDefinition: [ { entity: { name: 'I_Supplier', element: 'Supplier' }}]\r\n      supplier                    : lifnr;\r\n      @UI                         : { lineItem:       [ { position: 50  } ] , selectionField: [ { position: 40 } ] }\r\n      @Consumption.valueHelpDefinition: [ { entity: { name: 'I_CompanyCode', element: 'CompanyCode' }}]\r\n      companycode                 : bukrs;\r\n      @UI                         : { lineItem:       [ { position: 60  } ] }\r\n      @Semantics.amount.currencyCode : 'currency'\r\n      paymentamount               : ypym_e_paymentamount;\r\n      @UI                         : { lineItem:       [ { position: 70  } ] }\r\n      currency                    : waers;\r\n      @UI                         : { lineItem:       [ { position: 80  } ] }\r\n      @EndUserText.label          : 'Satıcı IBAN'\r\n      supplieriban                : iban;\r\n      @UI                         : { lineItem:       [ { position: 90  } ] }\r\n      companybankcode             : hbkid;\r\n      @UI                         : { lineItem:       [ { position: 100  } ] }\r\n      @EndUserText.label          : 'Şirket IBAN'\r\n      companyiban                 : iban;\r\n      @UI                         : { lineItem:       [ { position: 110  } ] , selectionField: [ { position: 50 } ] }\r\n      glaccount                   : hkont;\r\n      @UI                         : { lineItem:       [ { position: 120  } ] }\r\n      paymentrequestdate          : ypym_e_paymentrequestdate;\r\n      @UI                         : { selectionField: [ { position: 130 } ] }\r\n      @Consumption.valueHelpDefinition: [ { entity: { name: 'YVH_PYM_APPROVEMENTSTATUS', element: 'Value' }}]\r\n      approvementstatus           : ypym_e_approvementstatus;\r\n      @UI                         : { lineItem:       [ { position: 140  } ] }\r\n      @EndUserText.label          : 'Onay Durumu'\r\n\r\n      approvementstatus_tx        : val_text;\r\n      @UI                         : { selectionField: [ { position: 150 } ] }\r\n      @Consumption.valueHelpDefinition: [ { entity: { name: 'YVH_PYM_BANKFILESTATUS', element: 'Value' }}]\r\n      bankfilestatus              : ypym_e_bankfilestatus;\r\n      @UI                         : { lineItem:       [ { position: 160  } ] }\r\n      @EndUserText.label          : 'Banka Dosya Durumu'\r\n      bankfilestatus_tx           : val_text;\r\n      @UI                         : { selectionField: [ { position: 170 } ] }\r\n      @Consumption.valueHelpDefinition: [ { entity: { name: 'YVH_PYM_PAYMENTSTATUS', element: 'Value' }}]\r\n      paymentstatus               : ypym_e_paymentstatus;\r\n      @UI                         : { lineItem:       [ { position: 180  } ] }\r\n      @EndUserText.label          : 'Ödeme Durumu'\r\n      paymentstatus_tx            : val_text;\r\n      @UI                         : { lineItem:       [ { position: 190  } ] }\r\n      @EndUserText.label          : 'Ödeme Belgesi'\r\n      @Consumption.semanticObject : 'AccountingDocument'\r\n      @Consumption.semanticObjectMapping:\r\n                                    { additionalBinding       : [{localElement: 'paymentdocument' , element: 'AccountingDocument'},\r\n                                                                 {localElement: 'companycode' , element: 'CompanyCode'},\r\n                                                                 {localElement: 'paymentdocumentyear', element: 'FiscalYear' }]}      \r\n      paymentdocument             : belnr_d;\r\n      @UI                         : { lineItem:       [ { position: 200  } ] }\r\n      @EndUserText.label          : 'Ödeme Belgesi Yılı'\r\n      paymentdocumentyear         : gjahr;\r\n}\r\n/*+[internal] {\n\"BASEINFO\":\n{\n\"FROM\":\n[],\n\"ASSOCIATED\":\n[],\n\"BASE\":\n[],\n\"ANNO_REF\":\n[],\n\"SCALAR_FUNCTION\":\n[],\n\"VERSION\":0,\n\"ANNOREF_EVALUATION_ERROR\":\"\"\n}\n}*/",
