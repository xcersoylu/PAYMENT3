    "SOURCE":"@EndUserText.label: 'Müşteri Ödeme Listesi Raporu'\r\n@ObjectModel.query.implementedBy:'ABAP:YCL_PYM_CUSTOMER_REPORT'\r\n@UI:{\r\nheaderInfo:{\r\n                typeNamePlural: 'Müşteri Ödeme Listesi Raporu',\r\n                typeName: 'Müşteri Ödeme Listesi Raporu',\r\n                title:{ type: #STANDARD, label: 'Müşteri Ödeme Listesi Raporu', value: 'paymentnumber' }\r\n\r\n           }\r\n}\r\ndefine root custom entity YI_PYM_DDL_CUSTOMER_REPORT\r\n{\r\n      @UI                         : { lineItem:       [ { position: 10  } ] , selectionField: [ { position: 10 } ] }\r\n  key paymentnumber               : ypym_e_paymentnumber;\r\n      @Consumption.semanticObject : 'AccountingDocument'\r\n      @Consumption.semanticObjectMapping:\r\n                                    { additionalBinding       : [{localElement: 'accountingdocument' , element: 'AccountingDocument'},\r\n                                                                 {localElement: 'companycode' , element: 'CompanyCode'},\r\n                                                                 {localElement: 'fiscalyear', element: 'FiscalYear' }]}\r\n        @UI                         : { lineItem:       [ { position: 20  } ] , selectionField: [ { position: 20 } ] }\r\n  key accountingdocument          : belnr_d;\r\n      @UI                         : { lineItem:       [ { position: 30  } ] }\r\n  key fiscalyear                  : gjahr;\r\n      @UI                         : { lineItem:       [ { position: 40  } ] }\r\n  key accountingdocumentitem      : buzei;\r\n      @UI                         : { lineItem:       [ { position: 50  } ] , selectionField: [ { position: 30 } ] }\r\n      @Consumption.valueHelpDefinition: [ { entity: { name: 'I_Supplier', element: 'Supplier' }}]\r\n      customer                    : kunnr;\r\n      @UI                         : { lineItem:       [ { position: 60  } ] , selectionField: [ { position: 40 } ] }\r\n      @Consumption.valueHelpDefinition: [ { entity: { name: 'I_CompanyCode', element: 'CompanyCode' }}]\r\n      companycode                 : bukrs;\r\n      @UI                         : { lineItem:       [ { position: 70  } ] }\r\n      @Semantics.amount.currencyCode : 'currency'\r\n      paymentamount               : ypym_e_paymentamount;\r\n      @UI                         : { lineItem:       [ { position: 80  } ] }\r\n      currency                    : waers;\r\n      @UI                         : { lineItem:       [ { position: 90  } ] }\r\n      @EndUserText.label          : 'Satıcı IBAN'\r\n      customeriban                : iban;\r\n      @UI                         : { lineItem:       [ { position: 100  } ] }\r\n      companybankcode             : hbkid;\r\n      @UI                         : { lineItem:       [ { position: 110  } ] }\r\n      @EndUserText.label          : 'Şirket IBAN'\r\n      companyiban                 : iban;\r\n      @UI                         : { lineItem:       [ { position: 120  } ] , selectionField: [ { position: 50 } ] }\r\n      glaccount                   : hkont;\r\n      @UI                         : { lineItem:       [ { position: 130  } ] }\r\n      paymentrequestdate          : ypym_e_paymentrequestdate;\r\n      @UI                         : { selectionField: [ { position: 60 } ] }\r\n      @Consumption.valueHelpDefinition: [ { entity: { name: 'YVH_PYM_APPROVEMENTSTATUS', element: 'Value' }}]\r\n      approvementstatus           : ypym_e_approvementstatus;\r\n      @UI                         : { lineItem:       [ { position: 140  } ] }\r\n      @EndUserText.label          : 'Onay Durumu'\r\n      approvementstatus_tx        : val_text;\r\n      @UI                         : { selectionField: [ { position: 70 } ] }\r\n      @Consumption.valueHelpDefinition: [ { entity: { name: 'YVH_PYM_BANKFILESTATUS', element: 'Value' }}]\r\n      bankfilestatus              : ypym_e_bankfilestatus;\r\n      @UI                         : { lineItem:       [ { position: 150  } ] }\r\n      @EndUserText.label          : 'Banka Dosya Durumu'\r\n      bankfilestatus_tx           : val_text;\r\n      @UI                         : { selectionField: [ { position: 80 } ] }\r\n      @Consumption.valueHelpDefinition: [ { entity: { name: 'YVH_PYM_PAYMENTSTATUS', element: 'Value' }}]\r\n      paymentstatus               : ypym_e_paymentstatus;\r\n      @UI                         : { lineItem:       [ { position: 160  } ] }\r\n      @EndUserText.label          : 'Ödeme Durumu'\r\n      paymentstatus_tx            : val_text;\r\n      @UI                         : { lineItem:       [ { position: 170  } ] }\r\n      @EndUserText.label          : 'Ödeme Belgesi'\r\n      @Consumption.semanticObject : 'AccountingDocument'\r\n      @Consumption.semanticObjectMapping:\r\n                                    { additionalBinding       : [{localElement: 'paymentdocument' , element: 'AccountingDocument'},\r\n                                                                 {localElement: 'companycode' , element: 'CompanyCode'},\r\n                                                                 {localElement: 'paymentdocumentyear', element: 'FiscalYear' }]}      \r\n      paymentdocument             : belnr_d;\r\n      @UI                         : { lineItem:       [ { position: 180  } ] }\r\n      @EndUserText.label          : 'Ödeme Belgesi Yılı'\r\n      paymentdocumentyear         : gjahr;\r\n      @UI                         : { lineItem:       [ { position: 190  } ] }\r\n      @EndUserText.label          : 'Denkleştirme Belgesi'\r\n      @Consumption.semanticObject : 'AccountingDocument'\r\n      @Consumption.semanticObjectMapping:\r\n                                    { additionalBinding       : [{localElement: 'clearingdocument' , element: 'AccountingDocument'},\r\n                                                                 {localElement: 'companycode' , element: 'CompanyCode'},\r\n                                                       